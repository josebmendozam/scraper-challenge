{
  "name": "scraper-challenge",
  "version": "1.0.0",
  "description": "Browserless TypeScript scraper for the TRF5 public PJe consultation portal",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "scrape": "npm run build --silent && npm start --",
    "lint": "eslint .",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "scraper",
    "typescript",
    "pje",
    "trf5"
  ],
  "author": "josebmendozam",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "axios-cookiejar-support": "^7.0.0",
    "cheerio": "^1.2.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
